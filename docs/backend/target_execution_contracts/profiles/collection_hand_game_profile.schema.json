{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sczn3.local/schemas/collection-hand-game-profile-v1.json",
  "title": "SCZN3 Collection/Hand Game Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["missionFamily", "resultPackageType", "resultPackageVersion", "profileId", "profileVersion", "publisherAuthority", "sourceDocuments", "approval", "effective", "lifecycle", "componentBindings", "claimGrade", "playerPolicy", "collectionPolicy", "memberMap", "handPatterns", "capabilityStates"],
  "properties": {
    "missionFamily": {"const": "collectionHandEvaluation"},
    "resultPackageType": {"const": "collectionHandResult"},
    "resultPackageVersion": {"const": "1"},
    "profileId": {"type": "string", "minLength": 1},
    "profileVersion": {"type": "string", "minLength": 1},
    "publisherAuthority": {"type": "object"},
    "sourceDocuments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "approval": {"type": "object"},
    "effective": {"type": "object"},
    "lifecycle": {"type": "object"},
    "componentBindings": {"type": "object"},
    "claimGrade": {"const": "publisher_collection_hand_result"},
    "playerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "minimumPlayers", "maximumPlayers"],
      "properties": {"mode": {"enum": ["solo", "alternating_players"]}, "minimumPlayers": {"type": "integer", "minimum": 1, "maximum": 8}, "maximumPlayers": {"type": "integer", "minimum": 1, "maximum": 8}}
    },
    "collectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handSize", "observationsPerTurn", "duplicatePolicy", "invalidObservationPolicy", "terminalPolicy"],
      "properties": {"handSize": {"type": "integer", "minimum": 1, "maximum": 50}, "observationsPerTurn": {"const": 1}, "duplicatePolicy": {"enum": ["allow_repeated_member", "count_once", "reject_duplicate"]}, "invalidObservationPolicy": {"enum": ["record_without_collection_member", "reject_turn"]}, "terminalPolicy": {"const": "fixed_turns_per_player"}}
    },
    "memberMap": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["collectionMemberId", "geometryEntityId", "publisherLabel", "sourceReference"]}},
    "handPatterns": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["handClassId", "publisherLabel", "precedence", "requiredMemberIds", "sourceReference"]}},
    "capabilityStates": {"type": "object"}
  }
}
