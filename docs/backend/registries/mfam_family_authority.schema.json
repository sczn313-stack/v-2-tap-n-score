{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sczn3.local/schemas/mfam-authority-v2.schema.json",
  "title": "SCZN3 Lean M/FAM Runtime Authority Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "registryId",
    "version",
    "status",
    "universalZeroingCapabilityId",
    "authorityChain",
    "inventory",
    "families",
    "familyAuthorityPackages",
    "mechanicalAuthorities",
    "products",
    "targetProfileBindings",
    "sources"
  ],
  "properties": {
    "schemaId": {"const": "sczn3-mfam-authority-v2"},
    "registryId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "governed"},
    "observedAt": {"type": "string"},
    "universalZeroingCapabilityId": {"const": "sczn3-governed-zeroing-road-v1"},
    "authorityChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "printerAuthority",
        "recognition",
        "ugo",
        "equipmentAuthority",
        "backend",
        "tapNScore",
        "expandedLearning"
      ],
      "properties": {
        "printerAuthority": {"type": "string", "minLength": 1},
        "recognition": {"type": "string", "minLength": 1},
        "ugo": {"type": "string", "minLength": 1},
        "equipmentAuthority": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "tapNScore": {"type": "string", "minLength": 1},
        "expandedLearning": {"type": "string", "minLength": 1}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "path"],
      "properties": {
        "catalogId": {"type": "string", "minLength": 1},
        "path": {"const": "registries/mfam_inventory_audit.json"}
      }
    },
    "families": {
      "type": "array",
      "items": {"$ref": "#/$defs/family"}
    },
    "familyAuthorityPackages": {
      "type": "array",
      "items": {"$ref": "#/$defs/familyAuthorityPackage"}
    },
    "mechanicalAuthorities": {
      "type": "array",
      "items": {"$ref": "#/$defs/mechanicalAuthority"}
    },
    "products": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    },
    "targetProfileBindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "name", "geometry", "procedure", "registration", "sourceIds"],
      "properties": {
        "familyId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "geometry": {"type": "object"},
        "procedure": {"type": "object"},
        "registration": {"type": "object"},
        "sourceIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "familyAuthorityPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyAuthorityPackageId",
        "familyId",
        "authorityVersion",
        "universalZeroingCapabilityId",
        "geometryAuthority",
        "aimAuthority",
        "measurementAuthority",
        "procedureAuthority",
        "mechanicalAuthorityIds",
        "confirmationAuthority",
        "sourceIds"
      ],
      "properties": {
        "familyAuthorityPackageId": {"type": "string", "minLength": 1},
        "familyId": {"type": "string", "minLength": 1},
        "authorityVersion": {"type": "string", "minLength": 1},
        "universalZeroingCapabilityId": {"const": "sczn3-governed-zeroing-road-v1"},
        "geometryAuthority": {"type": "object"},
        "aimAuthority": {"type": "object"},
        "measurementAuthority": {"type": "object"},
        "procedureAuthority": {"type": "object"},
        "mechanicalAuthorityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "confirmationAuthority": {"type": "object"},
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "mechanicalAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanicalAuthorityId", "equipmentConfiguration", "controls", "sourceIds"],
      "properties": {
        "mechanicalAuthorityId": {"type": "string", "minLength": 1},
        "equipmentConfiguration": {"type": "object"},
        "controls": {"type": "array", "items": {"type": "object"}},
        "sourceIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "publisherOrIssuer",
        "exactName",
        "face",
        "dimensions",
        "grid",
        "aim",
        "procedure",
        "applicableEquipment",
        "mechanicalAuthorityIds",
        "registration",
        "familyId",
        "sourceIds"
      ],
      "properties": {
        "productId": {"type": "string", "minLength": 1},
        "publisherOrIssuer": {"type": "string", "minLength": 1},
        "exactName": {"type": "string", "minLength": 1},
        "identifiers": {"type": "object"},
        "generationOrApplication": {"type": ["string", "null"]},
        "face": {"type": "object"},
        "dimensions": {"type": "object"},
        "grid": {"type": "object"},
        "aim": {"type": "object"},
        "procedure": {"type": "object"},
        "applicableEquipment": {"type": "array", "items": {"type": "string"}},
        "mechanicalAuthorityIds": {"type": "array", "items": {"type": "string"}},
        "registration": {"type": "object"},
        "familyId": {"type": ["string", "null"]},
        "sourceIds": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetProfileId",
        "productId",
        "familyId",
        "familyAuthorityPackageId",
        "mechanicalAuthorityId",
        "registrationPackageId",
        "canonicalRepresentationAuthority"
      ],
      "properties": {
        "targetProfileId": {"type": "string", "minLength": 1},
        "productId": {"type": "string", "minLength": 1},
        "familyId": {"type": "string", "minLength": 1},
        "familyAuthorityPackageId": {"type": "string", "minLength": 1},
        "mechanicalAuthorityId": {"type": "string", "minLength": 1},
        "registrationPackageId": {"type": "string", "minLength": 1},
        "inventoryFaceId": {"type": "string", "minLength": 1},
        "canonicalRepresentationAuthority": {"type": "object"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "title", "publisher", "url", "quality"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "quality": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
