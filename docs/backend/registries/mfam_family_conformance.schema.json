{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sczn3.local/schemas/mfam-family-conformance-v1.schema.json",
  "title": "SCZN3 M/FAM Target Family Conformance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "registryId",
    "version",
    "status",
    "authorityRegistryId",
    "admissionPolicy",
    "contracts",
    "reusableEvidencePackages",
    "evaluations",
    "scaleProof"
  ],
  "properties": {
    "schemaId": {"const": "sczn3-target-family-conformance-v1"},
    "registryId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "governed"},
    "authorityRegistryId": {"type": "string", "minLength": 1},
    "admissionPolicy": {"type": "object"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contract"}
    },
    "reusableEvidencePackages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidencePackage"}
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluation"}
    },
    "scaleProof": {"type": "object"}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "name", "scope", "required", "proofRule", "failureCode"],
      "properties": {
        "gateId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "scope": {"enum": ["FACE_CONFORMANCE", "EQUIPMENT_BRANCH", "REPRESENTATION_SPECIFIC"]},
        "required": {"const": true},
        "proofRule": {"type": "string", "minLength": 1},
        "failureCode": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "familyId",
        "familyAuthorityPackageId",
        "status",
        "requiredGates",
        "admissionRule"
      ],
      "properties": {
        "contractId": {"type": "string", "minLength": 1},
        "familyId": {"type": "string", "minLength": 1},
        "familyAuthorityPackageId": {"type": "string", "minLength": 1},
        "status": {"const": "GOVERNED"},
        "requiredGates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "admissionRule": {"type": "string", "minLength": 1}
      }
    },
    "evidencePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidencePackageId", "scope", "status", "facts", "sourceIds"],
      "properties": {
        "evidencePackageId": {"type": "string", "minLength": 1},
        "scope": {"enum": ["FAMILY", "ISSUED_PRODUCT_IDENTITY", "UNIVERSAL_CAPABILITY"]},
        "status": {"const": "PROVEN"},
        "facts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "status", "basis", "sourceIds"],
      "properties": {
        "gateId": {"type": "string", "minLength": 1},
        "status": {"enum": ["PROVEN", "UNRESOLVED"]},
        "basis": {"type": "string", "minLength": 1},
        "sourceIds": {"type": "array", "items": {"type": "string"}},
        "evidencePackageIds": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceId",
        "productId",
        "representationId",
        "contractId",
        "gateEvidence",
        "disposition",
        "irreducibleMissingFacts"
      ],
      "properties": {
        "faceId": {"type": "string", "minLength": 1},
        "productId": {"type": "string", "minLength": 1},
        "representationId": {"type": "string", "minLength": 1},
        "contractId": {"type": "string", "minLength": 1},
        "gateEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gateEvidence"}
        },
        "disposition": {"enum": ["ADMITTED", "HOLD"]},
        "targetProfileId": {"type": ["string", "null"]},
        "irreducibleMissingFacts": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
